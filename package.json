{
  "name": "tamil-mandram",
  "version": "1.0.0",
  "private": true,
  "description": "Tamil Mandram - Tamil literary and cultural club website",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,yellow \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "seed": "npm --workspace server run seed",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
